/*
Analysis 1: Annual trends in selected water-quality indicators

Purpose:
Compare annual average, minimum, maximum and measurement count
for selected water-quality parameters from 2021 to 2025.

Below-detection treatment:
Values reported as <x were replaced with x/2 in the cleaned field.

Important:
Results are descriptive trends and are not official regulatory
water-quality classifications.
*/

a. overall annual trends
SELECT
    sample_year,
    parameter_name,
    unit,
    ROUND(AVG(measurement_value_cleaned), 3) AS average_value,
    ROUND(MIN(measurement_value_cleaned), 3) AS minimum_value,
    ROUND(MAX(measurement_value_cleaned), 3) AS maximum_value,
    COUNT(measurement_value_cleaned) AS measurement_count
FROM `water-quality-510014.water_quality.Risk_assessment`
WHERE parameter_name IN (
    'Ammoniacal Nitrogen as N',
    'Orthophosphate, reactive as P',
    'Oxygen, Dissolved, % Saturation',
    'pH'
)
AND measurement_value_cleaned IS NOT NULL
GROUP BY
    sample_year,
    parameter_name,
    unit
ORDER BY
    parameter_name,
    sample_year;


b. annual trends by river stretch

    SELECT
    sample_year,
    river_stretch,
    parameter_name,
    unit,
    ROUND(AVG(measurement_value_cleaned), 3) AS average_value,
    ROUND(MIN(measurement_value_cleaned), 3) AS minimum_value,
    ROUND(MAX(measurement_value_cleaned), 3) AS maximum_value,
    COUNT(measurement_value_cleaned) AS measurement_count
FROM `water-quality-510014.water_quality.Risk_assessment`
WHERE parameter_name IN (
    'Ammoniacal Nitrogen as N',
    'Orthophosphate, reactive as P',
    'Oxygen, Dissolved, % Saturation',
    'pH'
)
AND measurement_value_cleaned IS NOT NULL
GROUP BY
    sample_year,
    river_stretch,
    parameter_name,
    unit
ORDER BY
    parameter_name,
    river_stretch,
    sample_year;

# Analysis 2: ammoniacal_nitrogen_anomaly.sql

a. Identify the measurements driving the anomaly

SELECT
    river_stretch,
    site_id,
    site_name,
    sample_date,
    measurement_value AS original_measurement,
    measurement_value_cleaned AS cleaned_measurement,
    below_detection_limit,
    unit
FROM `water-quality-510014.water_quality.Risk_assessment`
WHERE parameter_name = 'Ammoniacal Nitrogen as N'
  AND sample_year = 2021
  AND measurement_value_cleaned IS NOT NULL
ORDER BY measurement_value_cleaned DESC
LIMIT 10;

b. Compare the Cookham-Egham 2021 mean before and after excluding the 6.90 mg/L maximum result

SELECT
    river_stretch,
    COUNT(*) AS measurement_count,
    ROUND(AVG(measurement_value_cleaned), 3) AS mean_with_maximum,
    ROUND(
        AVG(
            CASE
                WHEN measurement_value_cleaned < 6.9
                THEN measurement_value_cleaned
            END
        ),
        3
    ) AS mean_without_6_9,
    ROUND(
        AVG(measurement_value_cleaned)
        - AVG(
            CASE
                WHEN measurement_value_cleaned < 6.9
                THEN measurement_value_cleaned
            END), 3
                    ) AS difference_caused_by_maximum
FROM `water-quality-510014.water_quality.Risk_assessment`
WHERE parameter_name = 'Ammoniacal Nitrogen as N'
  AND river_stretch = 'Cookham-Egham'
  AND sample_year = 2021
  AND measurement_value_cleaned IS NOT NULL
GROUP BY river_stretch;

# Analysis 3 Data Quality and Detection Limit

a.  Detection limit summary

/* Measure the proportion of results reported below detection limits
for each selected parameter, year and river stretch.

Below-detection treatment: Values reported as <x were replaced with x/2 in
measurement_value_cleaned.
*/ 

SELECT
    sample_year,
    river_stretch,
    parameter_name,
    unit,
    COUNT(measurement_value_cleaned) AS measurement_count,
    COUNTIF(below_detection_limit = 1) AS below_detection_count,
    ROUND(
        100 * SAFE_DIVIDE(
            COUNTIF(below_detection_limit = 1),
            COUNT(measurement_value_cleaned)
        ),
        2
    ) AS below_detection_percentage
FROM `water-quality-510014.water_quality.Risk_assessment`
WHERE parameter_name IN (
    'Ammoniacal Nitrogen as N',
    'Orthophosphate, reactive as P',
    'Oxygen, Dissolved, % Saturation',
    'pH' )
  AND measurement_value_cleaned IS NOT NULL
GROUP BY
    sample_year,
    river_stretch,
    parameter_name,
    unit
ORDER BY
    below_detection_percentage DESC,
    parameter_name,
    sample_year,
    river_stretch;

b. Monthly monitoring coverage

    /* Count the number of distinct monitored months for every parameter, year and river stretch.
This identifies annual summaries based on incomplete seasonal coverage.
*/

SELECT
    sample_year,
    river_stretch,
    parameter_name,
    COUNT(DISTINCT EXTRACT(MONTH FROM sample_date)) AS months_monitored,
    12 - COUNT(DISTINCT EXTRACT(MONTH FROM sample_date)) AS months_missing,
    COUNT(measurement_value_cleaned) AS measurement_count
FROM `water-quality-510014.water_quality.Risk_assessment`
WHERE parameter_name IN (
    'Ammoniacal Nitrogen as N',
    'Orthophosphate, reactive as P',
    'Oxygen, Dissolved, % Saturation',
    'pH',
    'Temperature of Water'
)
  AND sample_date IS NOT NULL
  AND measurement_value_cleaned IS NOT NULL
GROUP BY
    sample_year,
    river_stretch,
    parameter_name
ORDER BY
    months_monitored,
    parameter_name,
    sample_year,
    river_stretch;